# Copy to .env (ignored by Git). `npm run dev` (wrangler dev) reads it as the
# Worker's local secrets; the probe scripts read it with `node --env-file=.env`.
# Never commit a value, and never paste one into a chat (AGENTS.md).

# The QA Door43 OAuth application (#2). Leave the secret empty for a public PKCE client.
DOOR43_CLIENT_ID=
DOOR43_CLIENT_SECRET=
# 32 or more random bytes, base64 (docs/deployment.md §3).
SESSION_SIGNING_KEY=

# The QA test user, for probes and the Playwright smoke test only, never the app (E23).
TEST_ORG=
TEST_USER=
TEST_PASSWORD=
TEST_TOKEN=
